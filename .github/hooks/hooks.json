{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": ".github/hooks/session-logger.sh",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": ".github/hooks/session-logger-end.sh",
        "timeout": 10
      }
    ]
  }
}
