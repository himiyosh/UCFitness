    "next-auth": "^5.0.0-beta.30",
    "next-intl": "^4.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.6.0",
    "util": "^0.12.5",
    "web-push": "^3.6.7"
