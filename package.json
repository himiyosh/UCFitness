{
  "name": "step-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "pages:build": "npx @cloudflare/next-on-pages && node scripts/check-cloudflare-worker-size.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:agents": "node scripts/check-custom-agents.mjs",
    "check:rules": "bash scripts/check-ucfitness-rules.sh",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "check:all": "npm run check:rules && npm run check:i18n && npx tsc --noEmit && npm run lint",
    "audit:responsive": "node scripts/audit-responsive.mjs",
    "test:e2e": "playwright test",
    "test:e2e:dashboard": "node scripts/audit-dashboard-ux.mjs",
    "test:postgres:notification-outbox": "tsx scripts/test-notification-outbox-postgres.ts",
    "test:postgres:push-cas": "tsx scripts/test-push-cas-postgres.ts",
    "test:postgres:push-generation": "tsx scripts/test-push-generation-postgres.ts",
    "test:postgres:push-protocol": "tsx scripts/test-push-protocol-postgres.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "html-to-image": "^1.11.13",
    "jose": "^6.1.3",
    "next": "^15.5.21",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.6.0",
    "util": "^0.12.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "^15.5.21",
    "pg": "^8.17.2",
    "playwright": "^1.58.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "cookie": "0.7.2",
    "esbuild": "^0.28.0",
    "miniflare": "^4.20260526.0",
    "postcss": "8.5.18",
    "sharp": "0.35.3",
    "ws": "^8.21.0"
  }
}
